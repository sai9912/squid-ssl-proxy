#!/bin/bash
set -euo pipefail

USER_NAME="usr"
USER_PASS="pass"
ENABLE_AUTH="false"   # "true" to require proxy auth (default), "false" to disable auth
PORT="8080"
CONTAINER_NAME="squid-proxy"
BASE_DIR="/root/squid-auth-proxy"

ENABLE_AUTH="${ENABLE_AUTH,,}"
if [[ "$ENABLE_AUTH" != "true" && "$ENABLE_AUTH" != "false" ]]; then
  echo "ERROR: ENABLE_AUTH must be 'true' or 'false' (got: '$ENABLE_AUTH')" >&2
  exit 1
fi

# 1. Create necessary directories
mkdir -p "$BASE_DIR/data/auth" "$BASE_DIR/certs"
touch "$BASE_DIR/data/auth/passwd"
chmod 644 "$BASE_DIR/data/auth/passwd"

# 2. Generate SSL Certificate for Bumping if it doesn't exist
if [ ! -f "$BASE_DIR/certs/private.pem" ]; then
    echo "Generating Squid Root CA Certificate..."
    openssl req -new -newkey rsa:2048 -days 3650 -nodes -x509 \
        -keyout "$BASE_DIR/certs/private.pem" \
        -out "$BASE_DIR/certs/private.pem" \
        -subj "/C=IN/ST=Telangana/L=Hyderabad/O=SquidProxy/CN=SquidCA"
fi
chmod 644 "$BASE_DIR/certs/private.pem"

# 3. Create entrypoint.sh and Dockerfile
cat > "$BASE_DIR/entrypoint.sh" <<'EOF'
#!/bin/sh
set -eu
mkdir -p /var/log/squid /var/lib/ssl_db
if [ ! -f /var/lib/ssl_db/size ]; then
  rm -rf /var/lib/ssl_db/*
  /usr/local/bin/security_file_certgen -c -s /var/lib/ssl_db -M 4MB
fi
touch /var/log/squid/access.log /var/log/squid/cache.log
chown -R squid:squid /var/log/squid /var/lib/ssl_db
rm -f /tmp/squid.pid
tail -F /var/log/squid/access.log > /dev/stdout &
tail -F /var/log/squid/cache.log > /dev/stderr &
(
  while true; do
    sleep 86400
    : > /var/log/squid/access.log
    : > /var/log/squid/cache.log
  done
) &
exec squid -N -f /etc/squid/squid.conf -d 1
EOF
chmod +x "$BASE_DIR/entrypoint.sh"

echo "Building custom Squid image with OpenSSL support..."
cat > "$BASE_DIR/Dockerfile" <<'EOF'
FROM alpine:latest
RUN apk add --no-cache squid openssl
RUN CERTGEN_BIN="$(command -v security_file_certgen || find /usr -name security_file_certgen -type f 2>/dev/null | head -n1)" && \
    NCSA_BIN="$(command -v basic_ncsa_auth || find /usr -name basic_ncsa_auth -type f 2>/dev/null | head -n1)" && \
    test -n "$CERTGEN_BIN" && test -n "$NCSA_BIN" && \
    ln -sf "$CERTGEN_BIN" /usr/local/bin/security_file_certgen && \
    ln -sf "$NCSA_BIN" /usr/local/bin/basic_ncsa_auth && \
    rm -rf /var/lib/ssl_db && \
    /usr/local/bin/security_file_certgen -c -s /var/lib/ssl_db -M 4MB && \
    chown -R squid:squid /var/lib/ssl_db
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
CMD ["/entrypoint.sh"]
EOF

docker build --network host -t my-alpine-squid-ssl "$BASE_DIR"
IMAGE="my-alpine-squid-ssl"

# 4. Collect all active LAN and Wi-Fi IPv4 addresses (excluding lo, docker0, virtual bridges)
NET_ENTRIES=$(ip -4 -o addr show scope global 2>/dev/null \
  | awk '$2 !~ /^(lo|docker|br-|veth|virbr)/ {split($4, a, "/"); print $2 ":" a[1]}' \
  || true)

IPS=$(echo "$NET_ENTRIES" | awk -F':' 'NF==2 {print $2}')

if [ -z "${IPS:-}" ]; then
  echo "ERROR: No active LAN or Wi-Fi IPv4 address found. Connect to LAN or Wi-Fi and try again." >&2
  exit 1
fi

echo "Active interfaces & IPs detected:"
echo "$NET_ENTRIES"

if [[ "$ENABLE_AUTH" == "true" ]]; then
  HASH=$(openssl passwd -apr1 "$USER_PASS")
  printf '%s:%s\n' "$USER_NAME" "$HASH" > "$BASE_DIR/data/auth/passwd"
  chmod 644 "$BASE_DIR/data/auth/passwd"
fi

# 5. Build squid.conf
cat > "$BASE_DIR/squid.conf" <<EOF
visible_hostname proxy

EOF

i=1
for IP in $IPS; do
  echo "http_port ${IP}:${PORT} ssl-bump generate-host-certificates=on dynamic_cert_mem_cache_size=4MB tls-cert=/etc/squid-cert/private.pem tls-key=/etc/squid-cert/private.pem name=port_ip${i}" >> "$BASE_DIR/squid.conf"
  i=$((i+1))
done

echo "" >> "$BASE_DIR/squid.conf"

i=1
for IP in $IPS; do
  echo "acl to_ip${i} myportname port_ip${i}" >> "$BASE_DIR/squid.conf"
  i=$((i+1))
done

echo "" >> "$BASE_DIR/squid.conf"

i=1
for IP in $IPS; do
  echo "tcp_outgoing_address ${IP} to_ip${i}" >> "$BASE_DIR/squid.conf"
  i=$((i+1))
done

if [[ "$ENABLE_AUTH" == "true" ]]; then
  cat >> "$BASE_DIR/squid.conf" <<'EOF'

auth_param basic program /usr/local/bin/basic_ncsa_auth /etc/squid/passwd
auth_param basic realm Squid Proxy
auth_param basic credentialsttl 8 hours
auth_param basic children 20 startup=5 idle=5
auth_param basic casesensitive on

acl authenticated proxy_auth REQUIRED
EOF
fi

cat >> "$BASE_DIR/squid.conf" <<'EOF'

forwarded_for delete
via on
request_header_access X-Forwarded-For deny all
request_header_access Proxy-Connection deny all

acl SSL_ports port 443
acl Safe_ports port 80
acl Safe_ports port 443
acl Safe_ports port 1025-65535
acl CONNECT method CONNECT

http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
EOF

if [[ "$ENABLE_AUTH" == "true" ]]; then
  cat >> "$BASE_DIR/squid.conf" <<'EOF'
http_access allow authenticated
http_access deny all
EOF
else
  cat >> "$BASE_DIR/squid.conf" <<'EOF'
http_access allow all
EOF
fi

cat >> "$BASE_DIR/squid.conf" <<'EOF'

# -----------------------------------------------------------------------------
# SSL BUMP LOGIC (Peek & Splice / Bump)
# -----------------------------------------------------------------------------
acl target_ssl_domain ssl::server_name .tirupatibalaji.ap.gov.in
acl step1 at_step SslBump1
acl step2 at_step SslBump2

ssl_bump peek step1 all
ssl_bump bump step2 target_ssl_domain
ssl_bump splice step2 all

sslcrtd_program /usr/local/bin/security_file_certgen -s /var/lib/ssl_db -M 4MB
sslcrtd_children 20 startup=1 idle=1

# -----------------------------------------------------------------------------
# MEMORY CACHING & HEADER STRIPPING
# -----------------------------------------------------------------------------
cache_mem 256 MB
maximum_object_size_in_memory 20 MB

acl target_cache_domain dstdomain .tirupatibalaji.ap.gov.in

acl static_files urlpath_regex -i \.(png|jpg|jpeg|gif|ico|css|js|json|woff|woff2|ttf|svg)(\?.*)?$
acl cacheable_apis urlpath_regex -i /common/banks

reply_header_access Set-Cookie deny static_files
reply_header_access Vary deny static_files
reply_header_access Set-Cookie deny cacheable_apis
reply_header_access Vary deny cacheable_apis

cache allow target_cache_domain static_files
cache allow target_cache_domain cacheable_apis
cache deny all

access_log /var/log/squid/access.log
cache_log /var/log/squid/cache.log
logfile_rotate 0
pid_filename /tmp/squid.pid

client_persistent_connections on
server_persistent_connections on

refresh_pattern -i \.(png|jpg|jpeg|gif|ico|css|js|json|woff|woff2|ttf|svg)(\?.*)?$ 10080 100% 10080 override-expire override-lastmod ignore-reload ignore-no-cache ignore-no-store ignore-private ignore-auth ignore-must-revalidate
refresh_pattern -i /common/banks 10080 100% 10080 override-expire override-lastmod ignore-reload ignore-no-cache ignore-no-store ignore-private ignore-auth ignore-must-revalidate

refresh_pattern . 0 20% 4320
EOF

# Validate squid.conf before starting
docker run --rm \
  --entrypoint squid \
  -v "$BASE_DIR/squid.conf:/etc/squid/squid.conf:ro" \
  -v "$BASE_DIR/data/auth/passwd:/etc/squid/passwd:ro" \
  -v "$BASE_DIR/certs:/etc/squid-cert:ro" \
  "$IMAGE" \
  -k parse -f /etc/squid/squid.conf

# 6. Cleanup & Restart
docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true

echo "Starting Squid Proxy (ENABLE_AUTH=${ENABLE_AUTH})..."
docker run -d \
  --name "$CONTAINER_NAME" \
  --restart always \
  --network host \
  --log-opt max-size=50m \
  --log-opt max-file=3 \
  -v "$BASE_DIR/squid.conf:/etc/squid/squid.conf:ro" \
  -v "$BASE_DIR/data/auth/passwd:/etc/squid/passwd:ro" \
  -v "$BASE_DIR/certs:/etc/squid-cert:ro" \
  "$IMAGE"

sleep 3
echo "========================================="
echo "Proxy ready on all detected IPs:"
for ENTRY in $NET_ENTRIES; do
  IF_NAME="${ENTRY%%:*}"
  IF_IP="${ENTRY##*:}"
  if [[ "$ENABLE_AUTH" == "true" ]]; then
    echo "[$IF_NAME] curl -v -x http://${USER_NAME}:${USER_PASS}@${IF_IP}:${PORT} https://ifconfig.me"
  else
    echo "[$IF_NAME] curl -v -x http://${IF_IP}:${PORT} https://ifconfig.me"
  fi
done
echo "========================================="
docker logs -f "$CONTAINER_NAME"
